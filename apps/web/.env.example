# FloodGuard web configuration.
#
#   cp apps/web/.env.example apps/web/.env.local
#
# There are NO API KEYS here, by design. The browser only ever calls same-origin
# /api/*, which Next.js rewrites to the gateway server-side (see next.config.mjs).
# Keys live in apps/api/.env and never reach the client bundle.

# Where the FastAPI gateway is. Server-side only — not exposed to the browser.
FLOODGUARD_API_BASE=http://localhost:8000
