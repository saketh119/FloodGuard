# ──────────────────────────────────────────────────────────────────────────────
# FloodGuard API configuration
#
#   cp apps/api/.env.example apps/api/.env     then fill in the one key below.
#
# This file is the template and IS committed. apps/api/.env holds your real
# secrets and is gitignored — never commit it.
# ──────────────────────────────────────────────────────────────────────────────


# ══ THE ONLY KEY YOU NEED ═════════════════════════════════════════════════════
#
# Google Gemini — powers two things:
#   • /chat        writes the grounded answer over the retrieved NDMA/IMD passages
#   • AI summaries the narrative on each flood event
#
# Get one free at https://aistudio.google.com/apikey  (no billing required)
#
# Leave it blank and everything still runs: /chat returns the retrieved source
# passages verbatim, and event summaries fall back to a deterministic template.
# Both label themselves in the UI, so you always know which path produced the text.
#
GEMINI_API_KEY=

# Which model to call. gemini-2.5-flash is fast, cheap and has a free tier.
# Alternatives: gemini-2.5-pro (better, slower), gemini-2.0-flash (older).
GEMINI_MODEL=gemini-2.5-flash


# ══ LIVE WEATHER (optional but recommended) ═══════════════════════════════════
#
# OpenWeather — real observed conditions and a 5-day forecast per district, the
# platform's first genuinely live source. Free at https://openweathermap.org/api
# (60 calls/min). We use 14 calls per cycle: 7 districts x (current + forecast).
#
# Leave blank and the platform runs on IMD alone.
OPENWEATHER_API_KEY=


# ══ NO KEY REQUIRED ═══════════════════════════════════════════════════════════

# Weather / rainfall data source.
# Points at apps/mock-imd, which needs no credentials. The real IMD API
# (https://api.imd.gov.in) requires government-issued credentials — when those
# arrive, change this URL and add the auth header in
# apps/api/app/flood/collectors/imd_collector.py. Nothing else changes.
IMD_BASE_URL=http://localhost:8080
IMD_TIMEOUT_S=10

# The ML model and the RAG vector store are LOCAL FILES, not hosted services.
# Build them once with:
#   .venv/bin/python services/ml/training/train_flood_severity.py
#   .venv/bin/python services/rag/fast_ingest.py --reset
# Embeddings run locally via Chroma's bundled ONNX MiniLM — no embedding API key.


# ══ TUNING (safe defaults, change only if you need to) ════════════════════════

# How often the scheduler pulls from IMD, in seconds.
COLLECT_INTERVAL_S=60

# Set false to collect only when you POST /ingest/run.
SCHEDULER_ENABLED=true

# How long a flood event stays open to new corroborating evidence, in hours.
CORRELATION_WINDOW_HOURS=6

# How many guideline passages to retrieve per chat question.
RAG_TOP_K=5

# Browser origins allowed to call this API directly. The Next.js app proxies
# through its own origin, so this normally does not matter.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Storage. SQLite by default; point DATABASE_URL at Postgres to switch.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/floodguard
